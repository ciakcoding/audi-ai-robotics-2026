<mujoco model="g1_29dof basketball ring training scene">
  <include file="../assets/g1.xml"/>
  <compiler meshdir="../assets/assets"/>

  <option density="1.2" viscosity="0.000018"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
      texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
      contype="1" conaffinity="1" condim="3"/>

    <body name="throw_ball" pos="0.35 -0.30 1.20">
      <freejoint name="throw_ball_free"/>
      <geom name="throw_ball_geom" type="sphere" size="0.04" mass="0.05"
        rgba="0.9 0.4 0.1 1" contype="1" conaffinity="1" condim="3"/>
    </body>

    <body name="throw_target" pos="1.5 0 1.6">
      <geom name="backboard" type="box" size="0.02 0.6 0.45"
        pos="0.25 0 0.3" rgba="0.8 0.9 1.0 0.4"
        contype="1" conaffinity="1" condim="3"/>

      <!-- MuJoCo has no torus primitive. These overlapping capsules form a
           physical ring with a real opening. Its 0.16 m centerline radius,
           0.02 m tube and the 0.04 m ball give the ball center an effective
           0.10 m pass region, matching the green target. -->
      <geom name="rim_00" type="capsule" size="0.02" fromto="0.1600 0.0000 0 0.1478 0.0612 0" rgba="1 0.3 0 1"/>
      <geom name="rim_01" type="capsule" size="0.02" fromto="0.1478 0.0612 0 0.1131 0.1131 0" rgba="1 0.3 0 1"/>
      <geom name="rim_02" type="capsule" size="0.02" fromto="0.1131 0.1131 0 0.0612 0.1478 0" rgba="1 0.3 0 1"/>
      <geom name="rim_03" type="capsule" size="0.02" fromto="0.0612 0.1478 0 0.0000 0.1600 0" rgba="1 0.3 0 1"/>
      <geom name="rim_04" type="capsule" size="0.02" fromto="0.0000 0.1600 0 -0.0612 0.1478 0" rgba="1 0.3 0 1"/>
      <geom name="rim_05" type="capsule" size="0.02" fromto="-0.0612 0.1478 0 -0.1131 0.1131 0" rgba="1 0.3 0 1"/>
      <geom name="rim_06" type="capsule" size="0.02" fromto="-0.1131 0.1131 0 -0.1478 0.0612 0" rgba="1 0.3 0 1"/>
      <geom name="rim_07" type="capsule" size="0.02" fromto="-0.1478 0.0612 0 -0.1600 0.0000 0" rgba="1 0.3 0 1"/>
      <geom name="rim_08" type="capsule" size="0.02" fromto="-0.1600 0.0000 0 -0.1478 -0.0612 0" rgba="1 0.3 0 1"/>
      <geom name="rim_09" type="capsule" size="0.02" fromto="-0.1478 -0.0612 0 -0.1131 -0.1131 0" rgba="1 0.3 0 1"/>
      <geom name="rim_10" type="capsule" size="0.02" fromto="-0.1131 -0.1131 0 -0.0612 -0.1478 0" rgba="1 0.3 0 1"/>
      <geom name="rim_11" type="capsule" size="0.02" fromto="-0.0612 -0.1478 0 0.0000 -0.1600 0" rgba="1 0.3 0 1"/>
      <geom name="rim_12" type="capsule" size="0.02" fromto="0.0000 -0.1600 0 0.0612 -0.1478 0" rgba="1 0.3 0 1"/>
      <geom name="rim_13" type="capsule" size="0.02" fromto="0.0612 -0.1478 0 0.1131 -0.1131 0" rgba="1 0.3 0 1"/>
      <geom name="rim_14" type="capsule" size="0.02" fromto="0.1131 -0.1131 0 0.1478 -0.0612 0" rgba="1 0.3 0 1"/>
      <geom name="rim_15" type="capsule" size="0.02" fromto="0.1478 -0.0612 0 0.1600 0.0000 0" rgba="1 0.3 0 1"/>

      <!-- The visible green disk fills the rim's geometric 0.14 m inner
           radius.  The ball-centre success radius remains 0.10 m because the
           ball itself has a 0.04 m radius. -->
      <geom name="throw_target_geom" type="cylinder" size="0.14 0.003"
        contype="0" conaffinity="0" rgba="0.1 0.8 0.2 0.25"/>
    </body>
  </worldbody>

  <equality>
    <weld name="hold_throw_ball"
      body1="right_wrist_yaw_link"
      body2="throw_ball"
      relpose="0.105 0.039 0.015 1 0 0 0"
      active="true"
      solref="0.002 1"
      solimp="0.95 0.99 0.001"/>
  </equality>
</mujoco>
