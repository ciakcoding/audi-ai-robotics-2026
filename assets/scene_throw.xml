<mujoco model="g1_29dof_rev_1_0 scene">
  <include file="g1.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <!-- FIX: Added contype, conaffinity, and condim="3" for hard 3D physics collisions -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1" conaffinity="1" condim="3"/>
  
    <body name="throw_ball" pos="0.35 -0.30 1.20">
      <freejoint name="throw_ball_free"/>
      <!-- FIX: Added collision tags here too so it acts like a rock solid object -->
      <geom name="throw_ball_geom" type="sphere" size="0.04" mass="0.05" rgba="0.9 0.2 0.1 1" contype="1" conaffinity="1" condim="3"/>
    </body>

    <body name="throw_target" pos="0.55 0 0">
      <geom name="throw_target_geom" type="sphere" size="0.10"
            contype="0" conaffinity="0" rgba="0.1 0.8 0.2 0.45"/>
    </body>

  </worldbody>

  <equality>
    <weld name="hold_throw_ball"
          body1="right_wrist_yaw_link"
          body2="throw_ball"
          relpose="0.105 0.039 0.015 1 0 0 0"
          active="true"
          solref="0.002 1"
          solimp="0.95 0.99 0.001"/>

  </equality>

</mujoco>

