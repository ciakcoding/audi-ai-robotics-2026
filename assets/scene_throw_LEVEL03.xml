      <geom name="rim_4" type="capsule" fromto="-0.106  0.106 0  -0.150  0.000 0" size="0.015" contype="1" conaffinity="1" rgba="0.8 0.2 0.1 1"/>
      <geom name="rim_5" type="capsule" fromto="-0.150  0.000 0  -0.106 -0.106 0" size="0.015" contype="1" conaffinity="1" rgba="0.8 0.2 0.1 1"/>
      <geom name="rim_6" type="capsule" fromto="-0.106 -0.106 0   0.000 -0.150 0" size="0.015" contype="1" conaffinity="1" rgba="0.8 0.2 0.1 1"/>
      <geom name="rim_7" type="capsule" fromto=" 0.000 -0.150 0   0.106 -0.106 0" size="0.015" contype="1" conaffinity="1" rgba="0.8 0.2 0.1 1"/>
      <geom name="rim_8" type="capsule" fromto=" 0.106 -0.106 0   0.150  0.000 0" size="0.015" contype="1" conaffinity="1" rgba="0.8 0.2 0.1 1"/>
      
      <!-- The Physical Rim (Hollow, using 4 capsules) -->
      <!-- <geom name="rim_1" type="capsule" pos="0.15 0 0" size="0.015 0.15" euler="90 -90 0" contype="1" conaffinity="1" rgba="0.8 0.2 0.1 1"/>
      <geom name="rim_2" type="capsule" pos="-0.15 0 0" size="0.015 0.15" euler="90 -90 0" contype="1" conaffinity="1" rgba="0.8 0.2 0.1 1"/>
      <geom name="rim_3" type="capsule" pos="0 0.15 0" size="0.015 0.15" euler="-90 90 0" contype="1" conaffinity="1" rgba="0.8 0.2 0.1 1"/>
      <geom name="rim_4" type="capsule" pos="0 -0.15 0" size="0.015 0.15" euler="-90 90 0" contype="1" conaffinity="1" rgba="0.8 0.2 0.1 1"/> -->
    </body> 

